generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum RoleCode {
  ADMIN
  SUPERVISOR
  STAFF
}
enum RecordStatus {
  PENDING
  APPROVED
  REJECTED
}
enum ArrivalStatus {
  ON_TIME
  LATE
  VERY_LATE
}

model Role {
  id Int @id @default(autoincrement())
  code RoleCode @unique
  name String
  users User[]
}
model User {
  id String @id @default(uuid())
  username String @unique
  name String
  passwordHash String
  mustChangePassword Boolean @default(true)
  active Boolean @default(true)
  roleId Int
  role Role @relation(fields: [roleId], references: [id])
  attendance Attendance[]
  leaves LeaveRequests[]
  approvals Approvals[]
  notifications Notifications[]
  logs AuditLogs[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Attendance {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  day String
  checkedInAt DateTime
  note String @default("")
  status RecordStatus @default(PENDING)
  arrival ArrivalStatus
  approvals Approvals[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, day])
  @@index([day, status])
}
model LeaveRequests {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  day String
  category String
  note String @default("")
  status RecordStatus @default(PENDING)
  approvals Approvals[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, day])
  @@index([day, status])
}
model Approvals {
  id String @id @default(uuid())
  actorId String
  actor User @relation(fields: [actorId], references: [id])
  attendanceId String?
  attendance Attendance? @relation(fields: [attendanceId], references: [id], onDelete: SetNull)
  leaveId String?
  leave LeaveRequests? @relation(fields: [leaveId], references: [id], onDelete: SetNull)
  decision RecordStatus
  reason String?
  createdAt DateTime @default(now())
}
model WorkSchedule {
  id Int @id @default(1)
  startTime String @default("08:00")
  endTime String @default("17:00")
  toleranceMinutes Int @default(5)
  veryLateMinutes Int @default(30)
  timezone String @default("Europe/Istanbul")
  updatedAt DateTime @updatedAt
}
model Notifications {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  message String
  readAt DateTime?
  createdAt DateTime @default(now())
}
model Settings {
  id Int @id @default(1)
  institutionName String @default("Kurum Yoklama")
  logoData String?
  leaveCategories Json
  updatedAt DateTime @updatedAt
}
model AuditLogs {
  id String @id @default(uuid())
  actorId String?
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action String
  target String?
  ip String?
  detail Json?
  createdAt DateTime @default(now())
  @@index([createdAt])
}
